# ==============================================================================
# AGV Nexus - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or pass flags via --dart-define when building/running.
# Example: flutter run -d chrome --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJ...

# Supabase Project Configuration (Phase 2)
# The client publishable/anon key is safe for client applications when RLS is enabled.
# NEVER place your Supabase service_role key or PostgreSQL database password here!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Application Runtime Parameters
ENV=development
SIMULATED_MODE=true

# Robotics Gateway Endpoints (Phase 3)
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws/telemetry
