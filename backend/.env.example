# ==============================================================================
# AGV Nexus - Backend FastAPI Environment Configuration
# ==============================================================================

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (Comma-separated or list in Python)
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]

# Supabase Auth & Persistence (Phase 2 & Phase 3)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
REQUIRE_AUTH=false

# Robot Adapter Mode ('simulated', 'ros2', or 'disconnected')
ROBOT_ADAPTER_MODE=simulated
ROS_DOMAIN_ID=0
ROS_NAMESPACE=

# Timing & Staleness Parameters
TELEMETRY_STALE_AFTER_SECONDS=5.0
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=10.0
TELEMETRY_BROADCAST_HZ=10.0
MAX_MAP_PAYLOAD_BYTES=10485760
